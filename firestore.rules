rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userBelongsTo(clientId) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && exists(profilePath)
        && get(profilePath).data.active == true
        && get(profilePath).data.clientId == clientId;
    }

    // Each signed-in user can read only their own access profile.
    // Client-side creation and editing of access profiles is forbidden.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // A user can read only the company record assigned in their active profile.
    match /clients/{clientId} {
      allow get: if userBelongsTo(clientId);
      allow list, create, update, delete: if false;
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
